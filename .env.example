# qBittorrent connection
# Host uses IP auth bypass; credentials can be any non-empty placeholder.
QBITTORRENT_HOST=https://arr.theoakenshield.com/qbittorrent
QBITTORRENT_USERNAME=anything
QBITTORRENT_PASSWORD=anything

# Local listen address
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8765

# Polling
POLL_INTERVAL_SECONDS=1.0

# Grouping (comma-separated, case-insensitive)
# Common Sonarr/Radarr category names are pre-included so that arr-managed
# torrents classify correctly out of the box. Trim or extend to taste.
MOVIE_CATEGORIES=movies,films,radarr
TV_CATEGORIES=tv,shows,anime,tv-sonarr,sonarr

# Logging
LOG_LEVEL=INFO
